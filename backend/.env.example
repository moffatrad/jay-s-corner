DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:4200"

# Seed admin account (created by prisma/seed.ts)
ADMIN_EMAIL="admin@jayscorner.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Jay"

# Resend (email OTP + audience sync)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Jay's Corner <onboarding@resend.dev>"
# Optional: set after the first run logs the auto-created audience id, to reuse it instead of creating another.
RESEND_AUDIENCE_ID=""

# Cloudinary (image uploads — product photos, chat attachments, review photos)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
